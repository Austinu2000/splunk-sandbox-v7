{
  "schemaVersion": 1,
  "id": "AU-01",
  "version": 1,
  "title": "Inspect the Ansible Control Node",
  "track": "Ansible/Linux fundamentals",
  "objectives": [
    "Inspect the Ansible Control Node",
    "Verify the result through independent inspection and explain the observed state."
  ],
  "environments": [
    "lab"
  ],
  "level": 1,
  "prerequisites": [],
  "requiredCapabilities": [
    "inventory.inspect"
  ],
  "fixture": {
    "id": "au-01-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "Open Terminal. Run ssh svc_ansible@ansible01, then cd ~/splunk-automation. Commands run inside the virtual environment.",
      "paths": [
        "cli"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Run hostname and ansible --version. Distinguish the automation control node from a managed Splunk node.",
      "paths": [
        "cli"
      ]
    }
  ],
  "hints": [
    "Inspect the affected component or inventory file first.",
    "Use the documented command output to answer the evidence questions."
  ],
  "references": [
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/inventory_guide/intro_inventory.html",
      "vendorVersion": "Ansible inventory reference; bounded core 2.17 compatibility subset",
      "purpose": "Inventory groups, variables and targeting"
    },
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/cli/ansible-inventory.html",
      "vendorVersion": "Ansible CLI",
      "purpose": "Graph/list/host output"
    }
  ],
  "checks": [
    {
      "kind": "inspection",
      "label": "Verify successful inspection: hostname",
      "command": "hostname",
      "host": "ansible01"
    },
    {
      "kind": "inspection",
      "label": "Verify successful inspection: ansible --version",
      "command": "ansible --version",
      "host": "ansible01"
    },
    {
      "kind": "answer",
      "label": "Correct evidence-based answer: role",
      "id": "role",
      "derive": "role",
      "host": "ansible01"
    }
  ],
  "minutes": 15,
  "questions": [
    {
      "id": "role",
      "prompt": "What simulator component role does ansible01 have?"
    }
  ],
  "feedback": {
    "success": "Verified observations, answers and required operational state are correct.",
    "incomplete": "Inspect the failed checks; edits on disk may need activation."
  },
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-foundations:AU-01:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-foundations:AU-01:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-foundations:AU-01:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-foundations:AU-01:reset"
    },
    {
      "case": "resume",
      "test": "v7-foundations:AU-01:resume"
    },
    {
      "case": "isolation",
      "test": "v7-foundations:AU-01:isolation"
    }
  ]
}
