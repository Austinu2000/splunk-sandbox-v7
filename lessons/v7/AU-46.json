    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "Run playbooks/v7_upgrade_policy.yml and inspect the failed handler: the service name is misspelled Spunkd. The desired policy is maxKBps=256; the first component can have new source staged while its running configuration still has 128. Preserve this failure evidence.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Fix the handler service name and rerun the policy. An unchanged copied file does not automatically notify a previously failed handler. Use playbooks/v7_upgrade_activate.yml --limit ds01 for the explicit recovery restart of that already-staged component; inspect its native btool output and handler execution.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-3",
      "instruction": "Run the normal policy again for changed=0 on ds01, hf01 and lm01, retaining the original failure and a successful on-change handler run from the repaired source. Verify active maxKBps=256 on every target. The explicit recovery playbook deliberately requests a restart; the ordinary policy remains the idempotence check.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    }
  ],
  "hints": [
    "Inspect the original failure, target scope and active source before changing anything.",
    "Verify native operational state independently of a playbook exit code."
  ],
  "references": [
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html",
      "vendorVersion": "Ansible core bounded compatibility subset",
      "purpose": "On-change activation and explicit failed-handler recovery"
    },
    {
      "url": "https://help.splunk.com/en/data-management/manage-splunk-enterprise-indexers/9.4/deploy-the-indexer-cluster/perform-an-automated-rolling-upgrade-of-an-indexer-cluster",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Controlled upgrade order, artifact verification and health prerequisites"
    }
  ],
