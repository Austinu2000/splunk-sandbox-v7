{
  "schemaVersion": 1,
  "id": "SP-015",
  "version": 1,
  "title": "Route a New Data Source Into a Custom Index",
  "track": "Indexes and data lifecycle",
  "objectives": [
    "Route a New Data Source Into a Custom Index",
    "Verify the active operational state and explain the evidence."
  ],
  "environments": [
    "lab"
  ],
  "level": 2,
  "prerequisites": [
    "SP-006"
  ],
  "requiredCapabilities": [
    "index.standalone",
    "input.onboard",
    "search.execute"
  ],
  "fixture": {
    "id": "sp-015-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "Create application_logs on idx01. In Add Data activate /var/log/practice/application.log with sourcetype=app_log and destination application_logs. Supply two lines: status=500 service=checkout and status=200 service=checkout.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Verify both events and their destination through Search; changing a query cannot repair an incorrectly configured input.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    }
  ],
  "hints": [
    "Inspect effective configuration and the delivery error before changing a setting.",
    "Creating an index does not add events. Verify the destination, activation and search window independently."
  ],
  "references": [
    {
      "url": "https://help.splunk.com/en/data-management/manage-splunk-enterprise-indexers/9.4/manage-indexes/create-custom-indexes",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Native index administration and configuration"
    },
    {
      "url": "https://docs.splunk.com/Documentation/Splunk/9.4.0/Admin/Inputsconf",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Input and HEC configuration reference"
    }
  ],
  "checks": [
    {
      "kind": "index-state",
      "label": "application_logs is active on idx01 with the required settings",
      "host": "idx01",
      "name": "application_logs",
      "settings": {}
    },
    {
      "kind": "configuration",
      "label": "idx01: active inputs.conf index",
      "host": "idx01",
      "conf": "inputs",
      "stanza": "monitor:///var/log/practice/application.log",
      "key": "index",
      "equals": "application_logs",
      "effective": true
    },
    {
      "kind": "query",
      "label": "Search independently confirms the indexed result",
      "search": "index=application_logs source=\"/var/log/practice/application.log\" | stats count",
      "rows": 1,
      "cells": {
        "count": 2
      }
    },
    {
      "kind": "answer",
      "label": "Evidence answer: destination",
      "id": "destination",
      "expected": "application_logs"
    }
  ],
  "minutes": 20,
  "questions": [
    {
      "id": "destination",
      "prompt": "Which index received the two application events?"
    }
  ],
  "setup": [
    {
      "kind": "file",
      "host": "idx01",
      "path": "/opt/splunk/etc/system/local/server.conf",
      "text": "[general]\nserverName = idx01\n[clustering]\nmode = disabled\n",
      "apply": true,
      "owner": "splunk"
    }
  ],
  "feedback": {
    "success": "Completion requires active configuration, verified search results and correct evidence answers.",
    "incomplete": "Inspect failed outcomes. Disk changes require activation; data must be ingested explicitly."
  },
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-onboarding:SP-015:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-onboarding:SP-015:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-onboarding:SP-015:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-onboarding:SP-015:reset"
    },
    {
      "case": "resume",
      "test": "v7-onboarding:SP-015:resume"
    },
    {
      "case": "isolation",
      "test": "v7-onboarding:SP-015:isolation"
    }
  ]
}
