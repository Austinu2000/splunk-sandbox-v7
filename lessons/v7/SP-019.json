{
  "schemaVersion": 1,
  "id": "SP-019",
  "version": 1,
  "title": "Configure and Test an HTTP Event Collector Input",
  "track": "Data ingestion and parsing",
  "objectives": [
    "Configure and Test an HTTP Event Collector Input",
    "Verify the active operational state and explain the evidence."
  ],
  "environments": [
    "lab"
  ],
  "level": 2,
  "prerequisites": [
    "SP-006"
  ],
  "requiredCapabilities": [
    "index.standalone",
    "input.onboard",
    "search.execute"
  ],
  "fixture": {
    "id": "sp-019-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "Create hec_logs on idx01. In Add Data configure HEC input application with default/allowed index hec_logs and sourcetype=hec_training. Use its training-only token.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Send one JSON envelope via the Web test form or simulated curl to https://idx01:8088/services/collector/event, with event=\"status=201 service=checkout\" and source=\"hec-training\". Verify delivery.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-3",
      "instruction": "Try an invalid token and an unallowed index; rejected requests must not add events.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    }
  ],
  "hints": [
    "Inspect effective configuration and the delivery error before changing a setting.",
    "Creating an index does not add events. Verify the destination, activation and search window independently."
  ],
  "references": [
    {
      "url": "https://help.splunk.com/en/data-management/manage-splunk-enterprise-indexers/9.4/manage-indexes/create-custom-indexes",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Native index administration and configuration"
    },
    {
      "url": "https://docs.splunk.com/Documentation/Splunk/9.4.0/Admin/Inputsconf",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Input and HEC configuration reference"
    }
  ],
  "checks": [
    {
      "kind": "index-state",
      "label": "hec_logs is active on idx01 with the required settings",
      "host": "idx01",
      "name": "hec_logs",
      "settings": {}
    },
    {
      "kind": "configuration",
      "label": "idx01: active inputs.conf disabled",
      "host": "idx01",
      "conf": "inputs",
      "stanza": "http",
      "key": "disabled",
      "equals": "0",
      "effective": true
    },
    {
      "kind": "configuration",
      "label": "idx01: active inputs.conf indexes",
      "host": "idx01",
      "conf": "inputs",
      "stanza": "http://application",
      "key": "indexes",
      "equals": "hec_logs",
      "effective": true
    },
    {
      "kind": "query",
      "label": "Search independently confirms the indexed result",
      "search": "index=hec_logs source=hec-training | stats count",
      "rows": 1,
      "cells": {
        "count": 1
      }
    },
    {
      "kind": "answer",
      "label": "Evidence answer: port",
      "id": "port",
      "expected": "8088"
    }
  ],
  "minutes": 20,
  "questions": [
    {
      "id": "port",
      "prompt": "Which default port receives HEC data, rather than management REST?"
    }
  ],
  "setup": [
    {
      "kind": "file",
      "host": "idx01",
      "path": "/opt/splunk/etc/system/local/server.conf",
      "text": "[general]\nserverName = idx01\n[clustering]\nmode = disabled\n",
      "apply": true,
      "owner": "splunk"
    }
  ],
  "feedback": {
    "success": "Completion requires active configuration, verified search results and correct evidence answers.",
    "incomplete": "Inspect failed outcomes. Disk changes require activation; data must be ingested explicitly."
  },
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-onboarding:SP-019:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-onboarding:SP-019:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-onboarding:SP-019:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-onboarding:SP-019:reset"
    },
    {
      "case": "resume",
      "test": "v7-onboarding:SP-019:resume"
    },
    {
      "case": "isolation",
      "test": "v7-onboarding:SP-019:isolation"
    }
  ]
}
