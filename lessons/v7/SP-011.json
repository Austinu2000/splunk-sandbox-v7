{
  "schemaVersion": 1,
  "id": "SP-011",
  "version": 1,
  "title": "Configure Index Retention and Storage Limits",
  "track": "Indexes and data lifecycle",
  "objectives": [
    "Configure Index Retention and Storage Limits",
    "Verify the active operational state and explain the evidence."
  ],
  "environments": [
    "lab"
  ],
  "level": 1,
  "prerequisites": [
    "SP-006"
  ],
  "requiredCapabilities": [
    "index.lifecycle",
    "input.onboard",
    "search.execute"
  ],
  "fixture": {
    "id": "sp-011-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "Create application_logs with retention 20 seconds and maxTotalDataSizeMB=1. Upload a training log under /var/log/practice/retention.log and monitor it into application_logs.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Verify the event, then advance the simulation clock at least 30 seconds. Inspect the frozen recorded-data bucket and confirm the event is no longer searchable. Whole buckets freeze; this model keeps small bounded teaching buckets.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    }
  ],
  "hints": [
    "Inspect effective configuration and the delivery error before changing a setting.",
    "Creating an index does not add events. Verify the destination, activation and search window independently."
  ],
  "references": [
    {
      "url": "https://help.splunk.com/en/data-management/manage-splunk-enterprise-indexers/9.4/manage-indexes/create-custom-indexes",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Native index administration and configuration"
    },
    {
      "url": "https://docs.splunk.com/Documentation/Splunk/9.4.0/Admin/Inputsconf",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Input and HEC configuration reference"
    }
  ],
  "checks": [
    {
      "kind": "index-state",
      "label": "application_logs is active on idx01 with the required settings",
      "host": "idx01",
      "name": "application_logs",
      "settings": {
        "frozenTimePeriodInSecs": 20,
        "maxTotalDataSizeMB": 1
      }
    },
    {
      "kind": "bucket-state",
      "label": "Ingested data expires through lifecycle",
      "host": "idx01",
      "index": "application_logs",
      "state": "frozen",
      "minimum": 1
    },
    {
      "kind": "query",
      "label": "Search independently confirms the indexed result",
      "search": "index=application_logs | stats count",
      "rows": 1,
      "cells": {
        "count": 0
      }
    },
    {
      "kind": "answer",
      "label": "Evidence answer: unit",
      "id": "unit",
      "expected": "MB"
    }
  ],
  "minutes": 20,
  "questions": [
    {
      "id": "unit",
      "prompt": "What unit does maxTotalDataSizeMB use?"
    }
  ],
  "setup": [
    {
      "kind": "file",
      "host": "idx01",
      "path": "/opt/splunk/etc/system/local/server.conf",
      "text": "[general]\nserverName = idx01\n[clustering]\nmode = disabled\n",
      "apply": true,
      "owner": "splunk"
    }
  ],
  "feedback": {
    "success": "Completion requires active configuration, verified search results and correct evidence answers.",
    "incomplete": "Inspect failed outcomes. Disk changes require activation; data must be ingested explicitly."
  },
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-onboarding:SP-011:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-onboarding:SP-011:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-onboarding:SP-011:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-onboarding:SP-011:reset"
    },
    {
      "case": "resume",
      "test": "v7-onboarding:SP-011:resume"
    },
    {
      "case": "isolation",
      "test": "v7-onboarding:SP-011:isolation"
    }
  ]
}
