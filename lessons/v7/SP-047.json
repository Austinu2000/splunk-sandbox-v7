{
  "schemaVersion": 1,
  "id": "SP-047",
  "version": 1,
  "title": "Create a Dashboard Through Splunk Web",
  "track": "Dashboards, alerts and knowledge objects",
  "objectives": [
    "Create a Dashboard Through Splunk Web",
    "Verify shared configuration, actual results and retained execution evidence."
  ],
  "environments": ["lab"],
  "level": 2,
  "prerequisites": ["SP-035"],
  "requiredCapabilities": ["search.execute", "dashboard.execute"],
  "fixture": {
    "id": "sp-047-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "The fixture supplies three explicit source_logs events and pauses the clock. Keep it paused while configuring; advance deliberately for scheduled work.",
      "paths": ["web", "cli", "config", "rest"]
    },
    {
      "id": "task-2",
      "instruction": "In Reports, inspect the supplied HTTP status report. It groups the three supplied source_logs records by status.",
      "paths": ["web", "cli", "config", "rest"]
    },
    {
      "id": "task-3",
      "instruction": "Create a Classic dashboard named http_overview in search, owner admin, Private. Add a table panel that references HTTP status report (the panel editor has a saved-report title field).",
      "paths": ["web", "cli", "config", "rest"]
    },
    {
      "id": "task-4",
      "instruction": "Open the dashboard and run its searches. Verify status=500/count=2 and independently inspect the native view XML or simulated /servicesNS/admin/search/data/ui/views endpoint.",
      "paths": ["web", "cli", "config", "rest"]
    }
  ],
  "hints": [
    "Inspect native configuration and the selected namespace. File edits need activation.",
    "Check search results before diagnosing alert conditions or dashboard rendering."
  ],
  "references": [
    {
      "url": "https://help.splunk.com/en/splunk-enterprise/create-dashboards-and-reports/simple-xml-dashboards/9.4/simple-xml-reference/simple-xml-reference",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Classic dashboard panels, searches and tokens"
    },
    {
      "url": "https://help.splunk.com/en/splunk-enterprise/create-dashboards-and-reports/dashboard-studio/9.4/source-code-editor/what-is-a-dashboard-definition",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Studio definitions, data sources, visualizations and inputs"
    },
    {
      "url": "https://help.splunk.com/en/data-management/splunk-enterprise-admin-manual/9.4/configuration-file-reference/9.4.1-configuration-file-reference/savedsearches.conf",
      "vendorVersion": "Splunk Enterprise 9.4.1",
      "purpose": "Alert conditions, scheduled execution and suppression"
    }
  ],
  "checks": [
    {
      "kind": "dashboard-state",
      "label": "Active dashboard configuration",
      "host": "sh01",
      "name": "http_overview",
      "format": "classic",
      "report": "HTTP status report"
    },
    {
      "kind": "dashboard-render",
      "label": "Actual panel results and provenance",
      "host": "sh01",
      "name": "http_overview",
      "cells": {
        "status": "500",
        "count": 2
      }
    },
    {
      "kind": "answer",
      "label": "Evidence answer",
      "id": "evidence",
      "expected": "2"
    }
  ],
  "questions": [
    {
      "id": "evidence",
      "prompt": "How many error events are represented by the repaired or selected results?"
    }
  ],
  "setup": [
    {
      "kind": "file",
      "host": "idx01",
      "path": "/opt/splunk/etc/system/local/server.conf",
      "text": "[clustering]\nmode=disabled\n",
      "owner": "splunk",
      "apply": false
    },
    {
      "kind": "file",
      "host": "idx01",
      "path": "/opt/splunk/etc/system/local/indexes.conf",
      "text": "[source_logs]\nhomePath=$SPLUNK_DB/source_logs/db\ncoldPath=$SPLUNK_DB/source_logs/colddb\nthawedPath=$SPLUNK_DB/source_logs/thaweddb\n",
      "owner": "splunk",
      "apply": false
    },
    {
      "kind": "file",
      "host": "idx01",
      "path": "/var/log/practice/reports.log",
      "text": "status=500 service=checkout latency=400\nstatus=200 service=auth latency=25\nstatus=500 service=checkout latency=300\n",
      "owner": "splunk",
      "apply": false
    },
    {
      "kind": "file",
      "host": "idx01",
      "path": "/opt/splunk/etc/system/local/inputs.conf",
      "text": "[monitor:///var/log/practice/reports.log]\nindex=source_logs\nsourcetype=app_log\ndisabled=0\n",
      "owner": "splunk",
      "apply": true
    },
    {
      "kind": "advance",
      "ticks": 1,
      "paused": true
    },
    {
      "kind": "file",
      "host": "sh01",
      "path": "/opt/splunk/etc/apps/search/local/savedsearches.conf",
      "text": "[HTTP status report]\nsearch=index=source_logs | stats count by status\ndispatch.earliest_time=-15m\ndispatch.latest_time=now\n",
      "owner": "splunk",
      "apply": true
    }
  ],
  "feedback": {
    "success": "Active source, actual result receipts and evidence satisfy the task.",
    "incomplete": "Inspect the missing outcome. Saving a definition alone does not execute its search."
  },
  "minutes": 25,
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-dashboards:SP-047:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-dashboards:SP-047:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-dashboards:SP-047:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-dashboards:SP-047:reset"
    },
    {
      "case": "resume",
      "test": "v7-dashboards:SP-047:resume"
    },
    {
      "case": "isolation",
      "test": "v7-dashboards:SP-047:isolation"
    }
  ]
}
