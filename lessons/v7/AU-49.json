  "tasks": [
    {
      "id": "task-1",
      "instruction": "Create a source branch for the requested engineering_release index in the v7_cluster_indexes role defaults. Open, check, approve and merge the simulated review. Preserve source history; merging the review must not publish the manager bundle.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Execute committed main playbooks/v7_cluster_indexes.yml --limit cm01. Inspect current bundle validation, publication and the actual completed three-peer bundle job. Confirm engineering_release is active on all peers with repFactor=auto, and use an independent source_logs count=3 search with Job Inspector to verify existing data stayed available.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    }
  ],
  "hints": [
    "Inspect the original failure, target scope and active source before changing anything.",
    "Verify native operational state independently of a playbook exit code."
  ],
  "references": [
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html",
      "vendorVersion": "Ansible core bounded compatibility subset",
      "purpose": "On-change activation and explicit failed-handler recovery"
    },
    {
      "url": "https://help.splunk.com/en/data-management/manage-splunk-enterprise-indexers/9.4/deploy-the-indexer-cluster/perform-an-automated-rolling-upgrade-of-an-indexer-cluster",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Controlled upgrade order, artifact verification and health prerequisites"
    }
  ],
  "checks": [
