    {
      "kind": "cluster-job",
      "label": "Actual reviewed three-peer bundle activation",
      "jobKind": "indexer-bundle",
      "index": "engineering_release",
      "minimumTargets": 3
    },
    {
      "kind": "index-state",
      "label": "idx01 active managed index",
      "host": "idx01",
      "name": "engineering_release",
      "settings": {
        "repFactor": "auto"
      }
    },
    {
      "kind": "index-state",
      "label": "idx02 active managed index",
      "host": "idx02",
      "name": "engineering_release",
      "settings": {
        "repFactor": "auto"
      }
    },
    {
      "kind": "index-state",
      "label": "idx03 active managed index",
      "host": "idx03",
      "name": "engineering_release",
      "settings": {
        "repFactor": "auto"
      }
    },
    {
      "kind": "query",
      "label": "Independent actual-data verification",
      "search": "index=source_logs | stats count",
      "rows": 1,
      "cells": {
        "count": 3
      }
    },
    {
      "kind": "search-job",
      "label": "Verification job and inspector retained",
