{
  "schemaVersion": 1,
  "id": "SP-008",
  "version": 1,
  "title": "Create and Inspect an Index Through the CLI",
  "track": "Indexes and data lifecycle",
  "objectives": [
    "Create and Inspect an Index Through the CLI",
    "Verify the active operational state and explain the evidence."
  ],
  "environments": [
    "lab"
  ],
  "level": 1,
  "prerequisites": [
    "SP-006"
  ],
  "requiredCapabilities": [
    "index.standalone",
    "input.onboard",
    "search.execute"
  ],
  "fixture": {
    "id": "sp-008-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "In Terminal, SSH to splunk@idx01. Run splunk add index application_logs -frozenTimePeriodInSecs 2592000.",
      "paths": [
        "cli"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Independently inspect splunk list index application_logs and splunk btool indexes list application_logs --debug. Identify the winning file.",
      "paths": [
        "cli"
      ]
    }
  ],
  "hints": [
    "Inspect effective configuration and the delivery error before changing a setting.",
    "Creating an index does not add events. Verify the destination, activation and search window independently."
  ],
  "references": [
    {
      "url": "https://help.splunk.com/en/data-management/manage-splunk-enterprise-indexers/9.4/manage-indexes/create-custom-indexes",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Native index administration and configuration"
    },
    {
      "url": "https://docs.splunk.com/Documentation/Splunk/9.4.0/Admin/Inputsconf",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Input and HEC configuration reference"
    }
  ],
  "checks": [
    {
      "kind": "index-state",
      "label": "application_logs is active on idx01 with the required settings",
      "host": "idx01",
      "name": "application_logs",
      "settings": {
        "frozenTimePeriodInSecs": 2592000
      }
    },
    {
      "kind": "inspection",
      "label": "Successful native CLI inspection",
      "command": "splunk list index application_logs",
      "host": "idx01",
      "afterChange": true
    },
    {
      "kind": "answer",
      "label": "Evidence answer: source",
      "id": "source",
      "expected": "/opt/splunk/etc/system/local/indexes.conf"
    }
  ],
  "minutes": 20,
  "questions": [
    {
      "id": "source",
      "prompt": "What absolute file contains the CLI-created definition?"
    }
  ],
  "setup": [
    {
      "kind": "file",
      "host": "idx01",
      "path": "/opt/splunk/etc/system/local/server.conf",
      "text": "[general]\nserverName = idx01\n[clustering]\nmode = disabled\n",
      "apply": true,
      "owner": "splunk"
    }
  ],
  "feedback": {
    "success": "Completion requires active configuration, verified search results and correct evidence answers.",
    "incomplete": "Inspect failed outcomes. Disk changes require activation; data must be ingested explicitly."
  },
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-onboarding:SP-008:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-onboarding:SP-008:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-onboarding:SP-008:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-onboarding:SP-008:reset"
    },
    {
      "case": "resume",
      "test": "v7-onboarding:SP-008:resume"
    },
    {
      "case": "isolation",
      "test": "v7-onboarding:SP-008:isolation"
    }
  ]
}
