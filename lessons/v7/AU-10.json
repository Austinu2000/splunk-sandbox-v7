{
  "schemaVersion": 1,
  "id": "AU-10",
  "version": 1,
  "title": "Inspect Inherited Group Variables",
  "track": "Inventory",
  "objectives": [
    "Inspect Inherited Group Variables",
    "Verify the result through independent inspection and explain the observed state."
  ],
  "environments": [
    "lab"
  ],
  "level": 1,
  "prerequisites": [],
  "requiredCapabilities": [
    "inventory.inspect"
  ],
  "fixture": {
    "id": "au-10-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "Open Terminal. Run ssh svc_ansible@ansible01, then cd ~/splunk-automation. Commands run inside the virtual environment.",
      "paths": [
        "cli"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Read group_vars/indexers/v7.yml and run ansible-inventory --host idx02. Identify the training_owner value inherited from indexers.",
      "paths": [
        "cli"
      ]
    }
  ],
  "hints": [
    "Inspect the affected component or inventory file first.",
    "Use the documented command output to answer the evidence questions."
  ],
  "references": [
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/inventory_guide/intro_inventory.html",
      "vendorVersion": "Ansible inventory reference; bounded core 2.17 compatibility subset",
      "purpose": "Inventory groups, variables and targeting"
    },
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/cli/ansible-inventory.html",
      "vendorVersion": "Ansible CLI",
      "purpose": "Graph/list/host output"
    }
  ],
  "checks": [
    {
      "kind": "inspection",
      "label": "Verify successful inspection: ansible-inventory --host idx02",
      "command": "ansible-inventory --host idx02",
      "host": "ansible01"
    },
    {
      "kind": "inventory",
      "label": "Group variable is effective for idx02",
      "pattern": "indexers",
      "variable": {
        "host": "idx02",
        "name": "training_owner",
        "value": "operations"
      }
    },
    {
      "kind": "answer",
      "label": "Correct evidence-based answer: owner",
      "id": "owner",
      "expected": "operations"
    }
  ],
  "minutes": 15,
  "questions": [
    {
      "id": "owner",
      "prompt": "What training_owner value does idx02 inherit?"
    }
  ],
  "feedback": {
    "success": "Verified observations, answers and required operational state are correct.",
    "incomplete": "Inspect the failed checks; edits on disk may need activation."
  },
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-foundations:AU-10:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-foundations:AU-10:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-foundations:AU-10:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-foundations:AU-10:reset"
    },
    {
      "case": "resume",
      "test": "v7-foundations:AU-10:resume"
    },
    {
      "case": "isolation",
      "test": "v7-foundations:AU-10:isolation"
    }
  ],
  "setup": [
    {
      "kind": "file",
      "host": "ansible01",
      "path": "/home/svc_ansible/splunk-automation/group_vars/indexers/v7.yml",
      "text": "training_owner: operations\n",
      "owner": "svc_ansible"
    }
  ]
}
