  "tasks": [
    {
      "id": "task-1",
      "instruction": "Inspect active limits.conf on ds01, hf01 and lm01 and the reviewed v7_upgrade_checks role. Two hosts drift from the intended maxKBps=128 policy. Preview the policy with --check --diff; this must not repair the active targets.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Apply playbooks/v7_upgrade_policy.yml to the three standalone infrastructure components and inspect its on-change restart handler. Run it again for changed=0 on the same current source. Confirm actual active native configuration on all three, with no peer or search-head package changes.",
      "paths": [
        "web",
        "cli",
        "config"
      ]
    }
  ],
  "hints": [
    "Inspect the original failure, target scope and active source before changing anything.",
    "Verify native operational state independently of a playbook exit code."
  ],
  "references": [
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/playbook_guide/playbooks_handlers.html",
      "vendorVersion": "Ansible core bounded compatibility subset",
      "purpose": "On-change activation and explicit failed-handler recovery"
