    {
      "url": "https://help.splunk.com/en/data-management/manage-splunk-enterprise-indexers/9.4/deploy-the-indexer-cluster/perform-an-automated-rolling-upgrade-of-an-indexer-cluster",
      "vendorVersion": "Splunk Enterprise 9.4",
      "purpose": "Controlled upgrade order, artifact verification and health prerequisites"
    }
  ],
  "checks": [
