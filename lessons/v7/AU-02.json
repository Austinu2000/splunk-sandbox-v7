{
  "schemaVersion": 1,
  "id": "AU-02",
  "version": 1,
  "title": "Connect with the Automation Service Account",
  "track": "Ansible/Linux fundamentals",
  "objectives": [
    "Connect with the Automation Service Account",
    "Verify the result through independent inspection and explain the observed state."
  ],
  "environments": [
    "lab"
  ],
  "level": 1,
  "prerequisites": [],
  "requiredCapabilities": [
    "inventory.inspect"
  ],
  "fixture": {
    "id": "au-02-v1",
    "version": 1,
    "seed": "lab-v1"
  },
  "tasks": [
    {
      "id": "task-1",
      "instruction": "Open Terminal. Run ssh svc_ansible@ansible01, then cd ~/splunk-automation. Commands run inside the virtual environment.",
      "paths": [
        "cli"
      ]
    },
    {
      "id": "task-2",
      "instruction": "Run whoami and id. Inspect the account used to read the automation repository.",
      "paths": [
        "cli"
      ]
    }
  ],
  "hints": [
    "Inspect the affected component or inventory file first.",
    "Use the documented command output to answer the evidence questions."
  ],
  "references": [
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/inventory_guide/intro_inventory.html",
      "vendorVersion": "Ansible inventory reference; bounded core 2.17 compatibility subset",
      "purpose": "Inventory groups, variables and targeting"
    },
    {
      "url": "https://docs.ansible.com/projects/ansible/latest/cli/ansible-inventory.html",
      "vendorVersion": "Ansible CLI",
      "purpose": "Graph/list/host output"
    }
  ],
  "checks": [
    {
      "kind": "inspection",
      "label": "Verify successful inspection: whoami",
      "command": "whoami",
      "host": "ansible01",
      "user": "svc_ansible"
    },
    {
      "kind": "inspection",
      "label": "Verify successful inspection: ^id$",
      "command": "^id$",
      "host": "ansible01",
      "user": "svc_ansible"
    },
    {
      "kind": "answer",
      "label": "Correct evidence-based answer: account",
      "id": "account",
      "expected": "svc_ansible"
    }
  ],
  "minutes": 15,
  "questions": [
    {
      "id": "account",
      "prompt": "Which account is active on the automation node?"
    }
  ],
  "feedback": {
    "success": "Verified observations, answers and required operational state are correct.",
    "incomplete": "Inspect the failed checks; edits on disk may need activation."
  },
  "reset": "restore-attempt-baseline",
  "persistence": "learner-profile-attempt",
  "status": "verified",
  "validation": [
    {
      "case": "solution",
      "test": "v7-foundations:AU-02:solution"
    },
    {
      "case": "incorrect-action",
      "test": "v7-foundations:AU-02:incorrect-action"
    },
    {
      "case": "no-false-completion",
      "test": "v7-foundations:AU-02:no-false-completion"
    },
    {
      "case": "reset",
      "test": "v7-foundations:AU-02:reset"
    },
    {
      "case": "resume",
      "test": "v7-foundations:AU-02:resume"
    },
    {
      "case": "isolation",
      "test": "v7-foundations:AU-02:isolation"
    }
  ]
}
